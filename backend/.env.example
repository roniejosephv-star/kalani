# Copy to .env locally. Never put these keys in SwiftUI or commit .env.
ANTHROPIC_API_KEY=
# A pinned Pi-catalogued model; change only after evaluation.
CLAUDE_MODEL=claude-sonnet-4-5
SARVAM_API_KEY=
CEDA_API_KEY=
FARM_DATA_DIR=.runtime
PORT=8787
# Optional reviewed operator-owned inputs (see src/adapters.ts types):
# FARM_CATALOGUE_FILE=/absolute/path/reviewed-catalogue.json
# FARM_MARKET_MAPPINGS_FILE=/absolute/path/verified-market-mappings.json
# FARM_ACCESS_FILE=/absolute/path/access.json
